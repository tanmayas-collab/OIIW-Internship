# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin console authentication (required in production for /admin, /api/applications, /api/export-csv)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_SESSION_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"

# Optional admissions notification & integrations
ADMISSIONS_EMAIL="ceo@aarogita.com"
GOOGLE_SHEETS_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="admissions@oiiw.org"
